# Copia a ".env" y rellena. NUNCA commitear .env. NUNCA prefijo NEXT_PUBLIC_ (filtraría al cliente).

# Conexion como rol NATIVO `lead_pages_serving` (minimo privilegio, internet-facing).
# SOLO: SELECT de artefacto_html por slug (estado='publicada') + INSERT/SELECT de propuesta_eventos
# + UPDATE de rollups de apertura. CERO acceso a companies/estado/contenido. NUNCA service_role,
# NUNCA postgres. Session pooler 5432:
#   postgresql://lead_pages_serving.<REF>:<PASSWORD>@aws-1-eu-central-1.pooler.supabase.com:5432/postgres
PROPOSALS_SERVING_DB_URL=
